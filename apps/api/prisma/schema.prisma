datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPERADMIN // platform-level, not tied to a tenant (tenantId is null)
  TENANT_ADMIN
  DISPATCHER
  // future: DRIVER (fleet driver portal access, phase 3+)
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  subdomain      String   @unique
  logoUrl        String?
  primaryColor   String   @default("#4F46E5")
  secondaryColor String   @default("#1E293B")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users     User[]
  customers Customer[]
  orders    Order[]

  @@index([isActive])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ordersCreated       Order[]               @relation("OrderCreatedBy")
  orderStatusChanges  OrderStatusHistory[]  @relation("OrderStatusChangedBy")

  // Composite unique keeps email unique per tenant. Note: Postgres treats each
  // NULL tenantId as distinct, so this alone does not guarantee globally-unique
  // emails across SUPERADMIN (tenantId = null) rows -- a follow-up partial
  // unique index (email WHERE tenantId IS NULL) enforces that separately.
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([tenantId])
  @@index([tenantId, name])
}

model Order {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  orderNumber   String
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  description   String?
  status        OrderStatus @default(PENDING)
  createdById   String?
  createdBy     User?       @relation("OrderCreatedBy", fields: [createdById], references: [id])
  originAddress String?
  destAddress   String?
  scheduledAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  statusHistory OrderStatusHistory[]
  // future (phase 2): shipments Shipment[] -- inter-city/multi-leg shipment linkage

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  status      OrderStatus
  note        String?
  changedById String?
  changedBy   User?       @relation("OrderStatusChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime    @default(now())

  @@index([orderId])
}

