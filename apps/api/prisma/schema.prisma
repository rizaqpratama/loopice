datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPERADMIN // platform-level, not tied to a tenant (tenantId is null)
  TENANT_ADMIN
  DISPATCHER
  // future: DRIVER (fleet driver portal access, phase 3+)
}

// A Service Order (SO) is the customer-facing request for logistics
// services. It moves through this lifecycle once at a time; CANCELLED is
// only reachable before work physically starts (DRAFT/QUOTED/CONFIRMED/
// PLANNED) -- once IN_PROGRESS or later, the job is already happening.
enum ServiceOrderStatus {
  DRAFT
  QUOTED
  CONFIRMED
  PLANNED
  IN_PROGRESS
  COMPLETED
  BILLED
  CLOSED
  CANCELLED
}

// A physical unit of cargo within a Service Order -- what actually gets
// loaded, moved, and tracked. One SO can contain many shipments.
enum ShipmentType {
  PALLET
  CONTAINER
  PARCEL
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  subdomain      String   @unique
  logoUrl        String?
  primaryColor   String   @default("#4F46E5")
  secondaryColor String   @default("#1E293B")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users         User[]
  customers     Customer[]
  serviceOrders ServiceOrder[]
  shipments     Shipment[]
  stations      Station[]
  shipmentLegs  ShipmentLeg[]

  @@index([isActive])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  serviceOrdersCreated      ServiceOrder[]              @relation("ServiceOrderCreatedBy")
  serviceOrderStatusChanges ServiceOrderStatusHistory[] @relation("ServiceOrderStatusChangedBy")
  shipmentLegStatusChanges  ShipmentLegStatusHistory[]  @relation("ShipmentLegStatusChangedBy")

  // Composite unique keeps email unique per tenant. Note: Postgres treats each
  // NULL tenantId as distinct, so this alone does not guarantee globally-unique
  // emails across SUPERADMIN (tenantId = null) rows -- a follow-up partial
  // unique index (email WHERE tenantId IS NULL) enforces that separately.
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceOrders ServiceOrder[]

  @@index([tenantId])
  @@index([tenantId, name])
}

model ServiceOrder {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  soNumber      String
  customerId    String
  customer      Customer           @relation(fields: [customerId], references: [id])
  description   String?
  status        ServiceOrderStatus @default(DRAFT)
  createdById   String?
  createdBy     User?              @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id])
  originAddress String?
  destAddress   String?
  scheduledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  statusHistory ServiceOrderStatusHistory[]
  shipments     Shipment[]
  shipmentLegs  ShipmentLeg[]

  @@unique([tenantId, soNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model ServiceOrderStatusHistory {
  id             String             @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder       @relation(fields: [serviceOrderId], references: [id])
  status         ServiceOrderStatus
  note           String?
  changedById    String?
  changedBy      User?              @relation("ServiceOrderStatusChangedBy", fields: [changedById], references: [id])
  changedAt      DateTime           @default(now())

  @@index([serviceOrderId])
}

// A pallet, container, or parcel within a Service Order -- the actual
// cargo units that get loaded and moved. No independent status yet in
// this pass; tracking lives at the Service Order level.
model Shipment {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  type           ShipmentType
  quantity       Int          @default(1)
  weightKg       Float?
  lengthCm       Float?
  widthCm        Float?
  heightCm       Float?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId])
  @@index([serviceOrderId])
}

enum ShipmentLegStatus {
  PLANNED
  IN_TRANSIT
  ARRIVED
  CANCELLED
}

// A tenant's reference/master data for inter-city routing hubs. No
// lifecycle of its own -- managed as simple directory data (create/
// update/deactivate) by TENANT_ADMIN, but readable by DISPATCHER too
// since they need it to plan routes.
model Station {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  city      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originLegs ShipmentLeg[] @relation("ShipmentLegOrigin")
  destLegs   ShipmentLeg[] @relation("ShipmentLegDest")

  @@unique([tenantId, code])
  @@index([tenantId])
}

// One station-to-station hop within a Service Order's overall route.
// legSequence orders legs 1..n for a given SO. No vehicle/driver yet --
// those are phase 3 (fleet management); adding unconstrained placeholder
// columns now would just be schema debt to retrofit into real FKs later.
model ShipmentLeg {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  serviceOrderId  String
  serviceOrder    ServiceOrder      @relation(fields: [serviceOrderId], references: [id])
  legSequence     Int
  originStationId String
  originStation   Station           @relation("ShipmentLegOrigin", fields: [originStationId], references: [id])
  destStationId   String
  destStation     Station           @relation("ShipmentLegDest", fields: [destStationId], references: [id])
  status          ShipmentLegStatus @default(PLANNED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  statusHistory ShipmentLegStatusHistory[]

  @@unique([serviceOrderId, legSequence])
  @@index([tenantId])
  @@index([serviceOrderId])
  @@index([originStationId])
  @@index([destStationId])
}

model ShipmentLegStatusHistory {
  id            String            @id @default(cuid())
  shipmentLegId String
  shipmentLeg   ShipmentLeg       @relation(fields: [shipmentLegId], references: [id])
  status        ShipmentLegStatus
  note          String?
  changedById   String?
  changedBy     User?             @relation("ShipmentLegStatusChangedBy", fields: [changedById], references: [id])
  changedAt     DateTime          @default(now())

  @@index([shipmentLegId])
}

